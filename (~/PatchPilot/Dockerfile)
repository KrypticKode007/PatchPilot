dockerfile# ==========================================
# Stage 1: Build & Dependency Resolution
# ==========================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system dependencies required to build Python audio libraries (e.g., numpy, scipy, librosa)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements to maximize Docker layer caching
COPY requirements.txt .

# Install packages into a localized deployment directory
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ==========================================
# Stage 2: Final Audio Mastering Runtime
# ==========================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Install essential system-level audio manipulation and processing binaries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    sox \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-installed Python audio packages from the builder stage
COPY --from=builder /install /usr/local

# Copy application source code 
COPY core/ ./core/

# Create a non-privileged user to safely run the mastering worker subprocesses
RUN useradd --create-home --shell /bin/bash pilotuser && \
    chown -R pilotuser:pilotuser /app

USER pilotuser

# Audio applications handle large multi-threaded chunks; prevent Python from buffering outputs
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2

# Expose the API server port
EXPOSE 8000

# Execute your app using an ASGI server (Uvicorn) pointing to your core module
CMD ["uvicorn", "core.app:app", "--host"